  "cosmic_laws": [
    {
      "id": "meniscus",
      "name": "Meniscus Law",
      "arabic": "قانون المنحنى السطحي",
      "symbol": "🏆",
      "rule": "Count only when crowned; below=0; overflow=archive",
      "principles": [
        "Value is not counted until crowning (reaching the peak)",
        "Everything below the peak = zero",
        "Surplus above the peak = archived"
      ],
      "applications": {
        "financial": "Bonds minted only at quarter close",
        "defense": "Response only when threat reaches maximum threshold",
        "measurement": "Count only at completion of cycle"
      }
    },
    {
      "id": "reciprocal",
      "name": "Reciprocal Law",
      "arabic": "قانون التبادل",
      "symbol": "♻️",
      "rule": "You cannot pull 1 from 2; you can pull 2 from 1; yield posts on reciprocal confirmation",
      "formula": {
        "valid": "1 → 2",
        "invalid": "2 → 1"
      },
      "principles": [
        "The One (origin) produces the Two (multiplication)",
        "The Two (product) cannot restore the One (origin)",
        "Exchange requires double confirmation"
      ],
      "applications": {
        "biology": "Egg (1) → embryo (2); embryo cannot produce egg",
        "finance": "Capital (1) → returns (2); returns do not fully restore capital",
        "energy": "Source (1) → energy (2); energy does not return to source"
      }
    },
    {
      "id": "fold",
      "name": "Fold Law",
      "arabic": "قانون الطي",
      "symbol": "🔄",
      "rule": "6°7 8 my fold law is what make the meniscus",
      "numbers": [6, 7, 8],
      "principles": [
        "Numbers 6-7-8 represent the cosmic turning/fold point",
        "This point creates the Meniscus",
        "The fold is the moment of transition between states"
      ],
      "applications": {
        "time": "Hours 6-7-8 (dawn, sunrise, morning) = daily turning points",
        "months": "Months 6-7-8 (mid-year) = annual turning point",
        "stages": "Childhood (6), Adolescence (7), Maturity (8)"
      }
    },
    {
      "id": "fill",
      "name": "Fill Law",
      "arabic": "قانون الامتلاء",
      "symbol": "💧",
      "rule": "Fill law think 2 can make 1 but 1 can't make 2",
      "formula": {
        "possible": "2 → 1",
        "impossible": "1 ↛ 2"
      },
      "principles": [
        "Union is possible (2 → 1)",
        "Division from origin is impossible (1 ↛ 2)",
        "Fullness occurs through union, not division"
      ],
      "relation_to_reciprocal": "Reciprocal: 1→2 (from origin) / Fill: 2→1 (toward completion)"
    },
    {
      "id": "averages",
      "name": "Averages Law",
      "arabic": "قانون المتوسطات",
      "symbol": "📊",
      "rule": "Order: individual → conference → nation; halt if one missing; restore; recompute",
      "hierarchy": ["individual", "conference", "nation"],
      "protocol": ["check presence", "halt if missing", "restore element", "recompute average"],
      "applications": {
        "education": "Student grade → class average → school average",
        "economy": "Individual income → city income → national income",
        "health": "Individual condition → community epidemic → national health"
      }
    },
    {
      "id": "formatting_504",
      "name": "Formatting 504 Law",
      "arabic": "قانون التنسيق 504",
      "symbol": "📝",
      "rule": "Commas, spaces, and indentation are legal structure; misformat = miscount",
      "number_504": {
        "5": "Five senses (perception)",
        "0": "Zero (void / space)",
        "4": "Four directions (structure)"
      },
      "examples": [
        "1,000 ≠ 1000 (legally different)",
        "\"Let's eat, Grandma\" ≠ \"Let's eat Grandma\""
      ]
    }
  ],

